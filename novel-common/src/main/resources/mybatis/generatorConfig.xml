<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
        "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">
<generatorConfiguration>
    <!--MyBatis Generator có năm chế độ: MyBatis3DynamicSql, MyBatis3Kotlin, MyBatis3, MyBatis3Simple và MyBatis3DynamicSqlV1.-->
    <context id="springboot-base" targetRuntime="MyBatis3DynamicSql">
        <commentGenerator>
            <!-- Loại bỏ comment tự sinh: true có, false không -->
            <property name="suppressAllComments" value="true"/>
        </commentGenerator>
        <jdbcConnection
                connectionURL="jdbc:mysql://127.0.0.1:3306/novel_plus?tinyInt1isBit=false&amp;useUnicode=true&amp;characterEncoding=utf-8&amp;serverTimezone=Asia/Shanghai&amp;nullCatalogMeansCurrent=true"
                driverClass="com.mysql.jdbc.Driver" password="test123456"
                userId="root"/>

        <!-- Mặc định false: ánh xạ JDBC DECIMAL và NUMERIC thành Integer; khi true ánh xạ JDBC DECIMAL
            và NUMERIC thành java.math.BigDecimal -->
        <javaTypeResolver>
            <property name="forceBigDecimals" value="false"/>
        </javaTypeResolver>

        <!-- targetProject: vị trí sinh lớp PO -->
        <javaModelGenerator
                targetPackage="com.java2nb.novel.entity"
                targetProject="novel-common/src/main/java">
            <!-- enableSubPackages: dùng schema làm hậu tố package hay không -->
            <property name="enableSubPackages" value="false"/>
            <!-- Loại khoảng trắng đầu/cuối của giá trị từ cơ sở dữ liệu -->
            <property name="trimStrings" value="true"/>
        </javaModelGenerator>

        <!-- targetProject: vị trí sinh tệp ánh xạ mapper -->
        <sqlMapGenerator targetPackage="mybatis.mapping"
                         targetProject="novel-common/src/main/resources">
            <!-- enableSubPackages: dùng schema làm hậu tố package hay không -->
            <property name="enableSubPackages" value="false"/>
        </sqlMapGenerator>

        <!-- targetPackage: vị trí sinh giao diện mapper -->
        <javaClientGenerator
                targetPackage="com.java2nb.novel.mapper"
                targetProject="novel-common/src/main/java" type="XMLMAPPER">
            <!-- enableSubPackages: dùng schema làm hậu tố package hay không -->
            <property name="enableSubPackages" value="false"/>
        </javaClientGenerator>

        <!--Đặt tableName=% để sinh cho mọi bảng-->
        <table tableName="website_info"/>

        <!-- Chỉ định bảng cơ sở dữ liệu -->
        <!--<table schema="jly" tableName="job_position" domainObjectName="JobPositionTest"/>-->
    </context>
</generatorConfiguration>
