<ehcache xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="ehcache.xsd">
	<!--timeToIdleSeconds: hủy bộ nhớ đệm sau n giây không hoạt động -->
	<!--timeToLiveSeconds: hủy bộ nhớ đệm sau n giây tồn tại -->
	<!-- Cấu hình cache: name là tên; maxElementsInMemory là số phần tử tối đa; eternal xác định đối tượng tồn tại vĩnh viễn và khi bật thì timeout không có tác dụng.
		timeToIdleSeconds đặt thời gian nhàn rỗi tối đa trước khi hết hiệu lực (giây); chỉ dùng khi eternal=false, mặc định 0 là không giới hạn.
		timeToLiveSeconds đặt thời gian sống tối đa trước khi hết hiệu lực (giây); chỉ dùng khi eternal=false, mặc định 0 là không giới hạn.
		overflowToDisk ghi đối tượng xuống đĩa khi đạt maxElementsInMemory; diskSpoolBufferSizeMB đặt kích thước bộ đệm DiskStore, mặc định 30 MB và mỗi cache nên có bộ đệm riêng.
		maxElementsOnDisk là số phần tử tối đa trên đĩa; diskPersistent xác định có giữ dữ liệu qua lần khởi động lại máy ảo hay không, mặc định là false.
		diskExpiryThreadIntervalSeconds là chu kỳ dọn dữ liệu hết hạn trên đĩa, mặc định 120 giây; memoryStoreEvictionPolicy là chính sách dọn bộ nhớ khi đạt giới hạn, mặc định là
		LRU (ít được dùng gần đây nhất); có thể chọn FIFO hoặc LFU. clearOnFlush xác định có xóa khi đầy bộ nhớ; maxEntriesLocalHeap="1000"
		: số đối tượng tối đa trong heap, 0 là không giới hạn (bắt buộc đặt); maxEntriesLocalDisk="1000" là số phần tử tối đa trên đĩa. -->
	<!-- Vị trí bộ nhớ đệm trên đĩa -->
	<diskStore path="user.dir/cachedata" />

	<!-- Bộ nhớ đệm mặc định -->
	<defaultCache maxElementsInMemory="10000" eternal="false"
		timeToIdleSeconds="120" timeToLiveSeconds="120"
		maxElementsOnDisk="10000000" diskExpiryThreadIntervalSeconds="120"
		memoryStoreEvictionPolicy="LRU">

		<persistence strategy="localTempSwap" />
	</defaultCache>

	<cache name="user" eternal="false" maxElementsInMemory="10000"
		   overflowToDisk="false" diskPersistent="false" timeToIdleSeconds="0"
		   timeToLiveSeconds="0" memoryStoreEvictionPolicy="LFU"/>




</ehcache>
