# Sao chép tệp này thành .env và thay toàn bộ giá trị change-me trước khi deploy.
COMPOSE_PROJECT_NAME=novel-plus
IMAGE_TAG=local
TZ=Asia/Ho_Chi_Minh
DB_TIMEZONE=Asia/Ho_Chi_Minh
CSP_ENFORCE=true

MYSQL_DATABASE=novel_plus
MYSQL_USER=novel
# Secret production nằm trong file, không đặt trực tiếp trong .env.
SECRETS_DIR=./secrets
# Cổng loopback chỉ được bật qua compose.test.yaml cho integration test.
MYSQL_HOST_PORT=3307
CRAWLER_ADMIN_USERNAME=admin
ADMIN_BOOTSTRAP_USERNAME=admin

# Caddy là cổng vào duy nhất. Ba domain phải trỏ về máy chạy Compose.
NOVEL_DOMAIN=example.com
NOVEL_ADMIN_DOMAIN=admin.example.com
NOVEL_CRAWL_DOMAIN=crawl.example.com
NOVEL_GRAFANA_DOMAIN=grafana.example.com
CADDY_ACME_EMAIL=ops@example.com
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
CADDY_MAX_UPLOAD_SIZE=25MB
CADDY_RATE_LIMIT_REQUESTS=600
CADDY_WRITE_RATE_LIMIT_REQUESTS=120

# Giám sát nội bộ. URL thông báo thật nằm trong secrets/alertmanager_webhook_url.
GRAFANA_ADMIN_USER=admin
PROMETHEUS_RETENTION=30d
ALERTMANAGER_ALLOW_HTTP=false

# Phải là đường dẫn tuyệt đối nằm ngoài thư mục repo trên máy production.
BACKUP_DIR=/var/backups/novel-plus
NOVEL_THEME=green
SHARDING_SQL_SHOW=false

# Tích hợp tùy chọn. Để trống nếu chưa sử dụng.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
AI_IMAGE_ENABLED=false
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_CHAT_MODEL=gpt-4.1-mini

# VNPAY bị tắt mặc định. Chỉ bật sau khi đã nhận credential merchant và khai báo IPN công khai.
# Hướng dẫn đầy đủ: doc/vnpay.md
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
# Secret checksum nằm trong secrets/vnpay_hash_secret.
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://example.com/pay/vnpay/return
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_XU_PER_1000_VND=100
VNPAY_ALLOWED_AMOUNTS_VND=10000,30000,50000,100000,200000,500000
# QueryDr đối soát đơn chờ khi IPN bị gián đoạn. IP server phải là IPv4/IPv6 hợp lệ.
VNPAY_RECONCILIATION_ENABLED=true
VNPAY_SERVER_IP=127.0.0.1
VNPAY_RECONCILIATION_DELAY_MS=300000
VNPAY_RECONCILIATION_INITIAL_DELAY_MS=60000
VNPAY_RECONCILIATION_MIN_AGE_MINUTES=20
VNPAY_RECONCILIATION_MAX_AGE_DAYS=30
VNPAY_RECONCILIATION_BATCH_SIZE=50

# VNPAY Recurring dùng bộ credential riêng do VNPAY cấp. Không dùng credential one-off.
# Callback/IPN phải là URL HTTPS công khai trước khi bật ở production.
VNPAY_RECURRING_ENABLED=false
VNPAY_RECURRING_BASE_URL=https://sandbox.vnpayment.vn
VNPAY_RECURRING_CLIENT_ID=
VNPAY_RECURRING_USERNAME=
VNPAY_RECURRING_TMN_CODE=
# Password/client secret/hash secret nằm trong ba file vnpay_recurring_* tại SECRETS_DIR.
VNPAY_RECURRING_PAY_URL=https://sandbox.vnpayment.vn/recurring-payment/pay
VNPAY_RECURRING_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RECURRING_SERVER_IP=127.0.0.1
VNPAY_RECURRING_RETURN_URL=https://example.com/payment/vnpay-recurring/return
VNPAY_RECURRING_CANCEL_URL=https://example.com/payment/vnpay-recurring/cancel
VNPAY_RECURRING_RESULT_REDIRECT_URL=/user/reading_tickets.html
VNPAY_RECURRING_ORDER_TYPE=other
VNPAY_RECURRING_CONNECT_TIMEOUT_SECONDS=5
VNPAY_RECURRING_REQUEST_TIMEOUT_SECONDS=15
VNPAY_RECURRING_QUERY_DELAY_MS=300000
VNPAY_RECURRING_REVOCATION_DELAY_MS=60000
VNPAY_RECURRING_REVOCATION_RETRY_DELAY_MS=300000
VNPAY_RECURRING_REVOCATION_LEASE_MS=60000
VNPAY_RECURRING_REVOCATION_BATCH_SIZE=50

# VietQR chỉ được bật khi webhook của đối tác ngân hàng đã được cấu hình.
# Secret phải là chuỗi ngẫu nhiên tối thiểu 32 ký tự.
VIETQR_ENABLED=false
VIETQR_BANK_BIN=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
# Webhook secret nằm trong secrets/vietqr_webhook_secret.

# Rút thu nhập tác giả bị tắt mặc định cho tới khi hoàn tất quy trình KYC/phê duyệt ngân hàng.
AUTHOR_PAYOUT_ENABLED=false
AUTHOR_PAYOUT_VND_PER_XU=10
AUTHOR_PAYOUT_MIN_XU=100000
AUTHOR_PAYOUT_REQUEST_OPEN_DAY=1
AUTHOR_PAYOUT_REQUEST_CLOSE_DAY=10

# Worker xuất bản chương đã lên lịch; giảm delay chỉ sau khi đo tải database.
AUTHOR_EDITOR_SCHEDULE_BATCH_SIZE=20
AUTHOR_EDITOR_SCHEDULE_DELAY_MS=30000
AUTHOR_EDITOR_SCHEDULE_INITIAL_DELAY_MS=30000

# Worker phát thông báo chương mới từ outbox; event lỗi retry tối đa 10 lần.
NOTIFICATION_CHAPTER_SCHEDULE_DELAY_MS=15000
NOTIFICATION_CHAPTER_SCHEDULE_INITIAL_DELAY_MS=15000

# Chỉ bật sau khi xác minh pháp nhân, mã số thuế và chính sách thuế/chứng từ.
FINANCIAL_VOUCHER_ISSUANCE_ENABLED=false
PLATFORM_LEGAL_NAME=
PLATFORM_TAX_CODE=
OSS_ENDPOINT=
OSS_KEY_ID=
OSS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_FILE_HOST=pic
OSS_WEB_URL=https://example.com/pic
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_NICKNAME=novel-plus
MAIL_USERNAME=
MAIL_PASSWORD=
DISK_MONITOR_ENABLED=false
DISK_MONITOR_RECIPIENTS=

# --- Bootstrap cấu hình Gamification ---
# Runtime và policy được quản trị trong database qua trang “Cấu hình Gamification”.
# DB là mặc định production. DB_SHADOW dùng khi đối chiếu ENV trước cutover; ENV chỉ dùng rollback.
GAMIFICATION_CONFIG_SOURCE=DB
GAMIFICATION_CONFIG_REFRESH_MS=2000
GAMIFICATION_CONFIG_MAX_STALE_MS=60000
GAMIFICATION_FORCE_DISABLE=false
GAMIFICATION_VOTE_IP_HASH_KEY_ID=v1
# Giá trị salt nằm trong file secret gamification_vote_ip_hash_salt, không đặt trong .env.
GAMIFICATION_VOTE_IP_HASH_SALT_FILE=/run/secrets/gamification_vote_ip_hash_salt
READING_TICKET_ENABLED=false
READING_TICKET_POLICY_VERSION=v1
READING_TICKET_MAX_LOTS_PER_SPEND=20
READING_TICKET_EXPIRY_CRON=0 30 3 * * ?
READING_TICKET_EXPIRY_BATCH_SIZE=500
READING_TICKET_EXPIRY_MAX_LOTS_PER_USER=1000
READING_SUBSCRIPTION_GRANT_CRON=0 10 0 * * ?
READING_SUBSCRIPTION_ZONE_ID=Asia/Ho_Chi_Minh
READING_SUBSCRIPTION_GRANT_BATCH_SIZE=200
READING_SUBSCRIPTION_RENEWAL_ENABLED=false
READING_SUBSCRIPTION_RENEWAL_DELAY_MS=60000
READING_SUBSCRIPTION_RENEWAL_BATCH_SIZE=100
READING_SUBSCRIPTION_ADMIN_ACTIVATION_ENABLED=false
GIFT_CODE_ENABLED=false
GIFT_CODE_HMAC_KEY_ID=legacy-v1
GIFT_CODE_HMAC_SECRET=replace-with-at-least-32-random-characters
# Danh sách keyId:Base64(secret cũ), phân tách bằng dấu chấm phẩy; tối đa 7 khóa cũ.
GIFT_CODE_HMAC_VERIFICATION_KEYS=
GIFT_CODE_POLICY_VERSION=v1
