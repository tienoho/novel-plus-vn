# Sao chép tệp này thành .env và thay toàn bộ giá trị change-me trước khi deploy.
COMPOSE_PROJECT_NAME=novel-plus
IMAGE_TAG=local
TZ=Asia/Ho_Chi_Minh
DB_TIMEZONE=Asia/Ho_Chi_Minh

MYSQL_DATABASE=novel_plus
MYSQL_USER=novel
# Cổng loopback dành cho migration/integration test chạy từ máy host; không bind ra LAN.
MYSQL_HOST_PORT=3307
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_APP_PASSWORD=change-me-app-password
REDIS_PASSWORD=change-me-redis-password

JWT_SECRET=change-me-with-at-least-32-random-characters
CACHE_MANAGER_PASSWORD=change-me-cache-password
CRAWLER_ADMIN_USERNAME=admin
CRAWLER_ADMIN_PASSWORD=change-me-crawler-password

# Khóa AES-256 dạng Base64 (32 byte). Bắt buộc trước khi nhận hồ sơ KYC.
# Tạo bằng: openssl rand -base64 32
PII_ENCRYPTION_KEY=

FRONT_PORT=8083
CRAWL_PORT=8081
ADMIN_PORT=8080
NOVEL_THEME=green
SHARDING_SQL_SHOW=false

# Tích hợp tùy chọn. Để trống nếu chưa sử dụng.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
AI_IMAGE_ENABLED=false
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_CHAT_MODEL=gpt-4.1-mini

# VNPAY bị tắt mặc định. Chỉ bật sau khi đã nhận credential merchant và khai báo IPN công khai.
# Hướng dẫn đầy đủ: doc/vnpay.md
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8083/pay/vnpay/return
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_XU_PER_1000_VND=100
VNPAY_ALLOWED_AMOUNTS_VND=10000,30000,50000,100000,200000,500000
# QueryDr đối soát đơn chờ khi IPN bị gián đoạn. IP server phải là IPv4/IPv6 hợp lệ.
VNPAY_RECONCILIATION_ENABLED=true
VNPAY_SERVER_IP=127.0.0.1
VNPAY_RECONCILIATION_DELAY_MS=300000
VNPAY_RECONCILIATION_INITIAL_DELAY_MS=60000
VNPAY_RECONCILIATION_MIN_AGE_MINUTES=20
VNPAY_RECONCILIATION_MAX_AGE_DAYS=30
VNPAY_RECONCILIATION_BATCH_SIZE=50

# VietQR chỉ được bật khi webhook của đối tác ngân hàng đã được cấu hình.
# Secret phải là chuỗi ngẫu nhiên tối thiểu 32 ký tự.
VIETQR_ENABLED=false
VIETQR_BANK_BIN=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
VIETQR_WEBHOOK_SECRET=

# Rút thu nhập tác giả bị tắt mặc định cho tới khi hoàn tất quy trình KYC/phê duyệt ngân hàng.
AUTHOR_PAYOUT_ENABLED=false
AUTHOR_PAYOUT_VND_PER_XU=10
AUTHOR_PAYOUT_MIN_XU=100000
AUTHOR_PAYOUT_REQUEST_OPEN_DAY=1
AUTHOR_PAYOUT_REQUEST_CLOSE_DAY=10

# Worker xuất bản chương đã lên lịch; giảm delay chỉ sau khi đo tải database.
AUTHOR_EDITOR_SCHEDULE_BATCH_SIZE=20
AUTHOR_EDITOR_SCHEDULE_DELAY_MS=30000
AUTHOR_EDITOR_SCHEDULE_INITIAL_DELAY_MS=30000

# Worker phát thông báo chương mới từ outbox; event lỗi retry tối đa 10 lần.
NOTIFICATION_CHAPTER_SCHEDULE_DELAY_MS=15000
NOTIFICATION_CHAPTER_SCHEDULE_INITIAL_DELAY_MS=15000

# Chỉ bật sau khi xác minh pháp nhân, mã số thuế và chính sách thuế/chứng từ.
FINANCIAL_VOUCHER_ISSUANCE_ENABLED=false
PLATFORM_LEGAL_NAME=
PLATFORM_TAX_CODE=
OSS_ENDPOINT=
OSS_KEY_ID=
OSS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_FILE_HOST=pic
OSS_WEB_URL=http://localhost:8083/pic
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_NICKNAME=novel-plus
MAIL_USERNAME=
MAIL_PASSWORD=
DISK_MONITOR_ENABLED=false
DISK_MONITOR_RECIPIENTS=

# --- Gamification: Ngọn Đuốc, nhiệm vụ, cảnh giới, xếp hạng tháng, quỹ thưởng ---
# Mọi cờ mặc định tắt. Thứ tự bật an toàn: EVENT -> TICKET -> VOTE -> SEASON -> QUEST -> REWARD.
# Ý nghĩa và lý do chọn từng ngưỡng: doc/gamification-policy-v1.md. Runbook: doc/gamification.md.
GAMIFICATION_POLICY_VERSION=v1
GAMIFICATION_ZONE_ID=Asia/Ho_Chi_Minh

# Thu nhận sự kiện. Ghi event chạy trong transaction nghiệp vụ nguồn; việc áp dụng phần thưởng
# chạy ở worker riêng nên lỗi luật nhiệm vụ không thể rollback giao dịch mua chương.
GAMIFICATION_EVENT_ENABLED=false
GAMIFICATION_EVENT_DRAIN_BATCH=200
GAMIFICATION_EVENT_DRAIN_DELAY_MS=15000
GAMIFICATION_EVENT_MAX_ATTEMPT=10

# Cấp và hết hạn Ngọn Đuốc. Không bán, không cấp theo nạp Xu ở phiên bản v1.
GAMIFICATION_TICKET_ENABLED=false
GAMIFICATION_TICKET_LOT_DAYS=60
GAMIFICATION_TICKET_GRANT_ON_TOPUP=false
GAMIFICATION_TICKET_EXPIRY_CRON=0 20 3 * * ?
GAMIFICATION_TICKET_EXPIRY_BATCH=500
GAMIFICATION_TICKET_MAX_GRANT_BATCH=1000

# Bỏ phiếu. Các giới hạn dưới đây có hiệu lực ở tầng database, không phụ thuộc Redis.
GAMIFICATION_VOTE_ENABLED=false
GAMIFICATION_VOTE_ALLOW_CRAWLED=false
# Bắt buộc tối thiểu 32 ký tự khi bật vote; không dùng chung JWT/Redis/database secret.
GAMIFICATION_VOTE_IP_HASH_SALT=disabled
GAMIFICATION_VOTE_MAX_PER_REQUEST=10
GAMIFICATION_VOTE_MAX_VOTES_DAY=20
GAMIFICATION_VOTE_MAX_TICKETS_DAY=50
GAMIFICATION_VOTE_MAX_PER_BOOK=100
GAMIFICATION_VOTE_MAX_LOTS=50

# Nhiệm vụ và EXP. Nhiệm vụ bình luận là thành tựu một lần, không phải nhiệm vụ hằng ngày.
GAMIFICATION_QUEST_ENABLED=false
GAMIFICATION_QUEST_REPLY_ENABLED=false
GAMIFICATION_QUEST_READ_MINUTES=30
GAMIFICATION_HEARTBEAT_INTERVAL=60
GAMIFICATION_HEARTBEAT_MAX_MIN=180

# Cảnh giới thuần danh xưng; không đổi phần thưởng hay quyền lợi.
GAMIFICATION_REALM_ENABLED=false
GAMIFICATION_REALM_AFFECTS_BENEFITS=false
GAMIFICATION_REALM_COOLDOWN_HOURS=24

# Kỳ xếp hạng. Giữ AUTO_FINALIZE=false để mọi kỳ đều qua mắt người trước khi chốt.
GAMIFICATION_SEASON_ENABLED=false
GAMIFICATION_SEASON_CLOSE_CRON=0 5 0 1 * ?
GAMIFICATION_SEASON_DRAIN_SECONDS=60
GAMIFICATION_SEASON_RESUME_DELAY_MS=30000
GAMIFICATION_SEASON_AUTO_FINALIZE=false
GAMIFICATION_SEASON_REVIEW_HOURS=72

# Quỹ thưởng. Chỉ bật sau khi shadow mode xác nhận xếp hạng khớp truy vấn nguồn.
# Thưởng nằm ở tài khoản clearing trong CLAIM_WINDOW_DAYS ngày trước khi vào ví tác giả.
GAMIFICATION_REWARD_ENABLED=false
GAMIFICATION_REWARD_CLAIM_WINDOW_DAYS=7
GAMIFICATION_REWARD_RELEASE_CRON=0 40 3 * * ?

# Worker theo lịch. Job kẹt quá LEASE_SECONDS không heartbeat sẽ được instance khác tiếp quản.
GAMIFICATION_JOB_LEASE_SECONDS=300
GAMIFICATION_JOB_BATCH_SIZE=500
READING_TICKET_ENABLED=false
READING_TICKET_POLICY_VERSION=v1
READING_TICKET_MAX_LOTS_PER_SPEND=20
READING_TICKET_EXPIRY_CRON=0 30 3 * * ?
READING_TICKET_EXPIRY_BATCH_SIZE=500
READING_TICKET_EXPIRY_MAX_LOTS_PER_USER=1000
READING_SUBSCRIPTION_GRANT_CRON=0 10 0 * * ?
READING_SUBSCRIPTION_ZONE_ID=Asia/Ho_Chi_Minh
READING_SUBSCRIPTION_GRANT_BATCH_SIZE=200
READING_SUBSCRIPTION_ADMIN_ACTIVATION_ENABLED=false
GIFT_CODE_ENABLED=false
GIFT_CODE_HMAC_KEY_ID=legacy-v1
GIFT_CODE_HMAC_SECRET=replace-with-at-least-32-random-characters
# Danh sách keyId:Base64(secret cũ), phân tách bằng dấu chấm phẩy; tối đa 7 khóa cũ.
GIFT_CODE_HMAC_VERIFICATION_KEYS=
GIFT_CODE_POLICY_VERSION=v1
